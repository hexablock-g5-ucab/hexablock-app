{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexablock.local/schemas/level.schema.json",
  "title": "HexaBlock level definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "gameId",
    "levelId",
    "order",
    "board",
    "spec"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gameId": {
      "enum": [
        "hexa-fit",
        "hexa-sort"
      ]
    },
    "levelId": {
      "type": "string",
      "pattern": "^(fit|sort)-[0-9]{3}$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "board": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "shape",
            "radius"
          ],
          "properties": {
            "shape": {
              "const": "hexagon"
            },
            "radius": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "shape",
            "cells"
          ],
          "properties": {
            "shape": {
              "const": "custom"
            },
            "cells": {
              "$ref": "#/$defs/cells"
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gameId": {
            "const": "hexa-fit"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "pieces",
              "stars"
            ],
            "properties": {
              "pieces": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "cells"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "cells": {
                      "$ref": "#/$defs/cells"
                    }
                  }
                }
              },
              "stars": {
                "type": "object",
                "required": [
                  "maxMovesFor3",
                  "secondsFor3"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gameId": {
            "const": "hexa-sort"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "goals",
              "colors",
              "seed"
            ],
            "properties": {
              "goals": {
                "type": "integer",
                "minimum": 1
              },
              "colors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
