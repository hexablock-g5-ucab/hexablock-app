---
title: "HexaBlock Suite · Modelo de clases v5 (1/5) — Núcleo genérico · packages/hexa_engine/lib/src/core"
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: "Inter"
    fontSize: "15px"
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction TB

  %% ===================== GEOMETRÍA =====================
  class HexCoord {
    <<inmutable>>
    +q: int «final»
    +r: int «final»
    +s: int «get»
    +operator +(o: HexCoord) HexCoord
    +neighbor(d: HexDirection) HexCoord
    +operator ==(o: Object) bool
    +hashCode: int «get»
  }
  class HexDirection {
    <<enumeration>>
    east · northEast · northWest
    west · southWest · southEast
    +delta: HexCoord
  }
  class HexGeometry {
    <<service · SRP>>
    +distance(a, b)$ int
    +rotate(c: HexCoord, steps: int)$ HexCoord
    +line(shape, axis: HexAxis, value: int)$ Iterable~HexCoord~
    +ring(center, radius: int)$ Iterable~HexCoord~
  }
  class HexAxis {
    <<enumeration>>
    q · r · s
  }
  class BoardShape {
    <<interface · Strategy de forma>>
    +contains(c: HexCoord) bool
    +cells: Set~HexCoord~
  }
  class HexagonShape {
    +radius: int — = GameSetup.boardRadius
  }

  %% ===================== TABLERO Y ESTADO =====================
  class HexBoard~TCell extends Object~ {
    <<Iterator · inmutable>>
    +shape: BoardShape
    -cells: Map~HexCoord, TCell~
    +operator [](c: HexCoord) TCell?
    +isFree(c: HexCoord) bool
    +put(c: HexCoord, cell: TCell) HexBoard~TCell~
    +remove(c: HexCoord) HexBoard~TCell~
    +line(axis: HexAxis, value: int) Iterable~HexCoord~
    +ring(center: HexCoord, radius: int) Iterable~HexCoord~
    +neighborsOf(c: HexCoord) Iterable~HexCoord~
  }
  class GameState~TCell extends Object~ {
    <<interface>>
    +board: HexBoard~TCell~
    +random: IRandom — viaja en la instantánea
  }
  class Piece~TCell extends Object~ {
    <<Prototype>>
    -offsets: Map~HexCoord, TCell~
    +rotated(steps: int) Piece~TCell~
    +placedAt(anchor: HexCoord) Map~HexCoord, TCell~
    +size: int
  }

  %% ===================== REGLAS (Strategy + Template Method) =====================
  class IGameRules~TCell, TMove, TState~ {
    <<interface · Strategy · punto de extensión>>
    +isValid(s: TState, m: TMove) bool
    +playTurn(s: TState, m: TMove) TurnResult~TState~
    +evaluate(s: TState) GameOutcome
  }
  class AbstractGameRules~TCell, TMove, TState~ {
    <<abstract · Template Method>>
    +playTurn(s, m) TurnResult~TState~ «@nonVirtual»
    #apply(s, m, events)* TState
    #resolve(s, events)* TState
    #afterResolve(s, events) TState
  }
  class TurnResult~TState~ {
    +state: TState
    +events: List~GameEvent~
  }
  class GameEvent {
    <<abstract · Observer (mensaje) · abierto>>
    +turn: int
  }
  class MoveRejected {
    +reason: String
  }
  class ScoreChanged {
    +score: Score
  }
  class GameEnded {
    +outcome: GameOutcome
  }
  class GameOutcome {
    <<enumeration>>
    ongoing · victory · defeat
  }

  %% ===================== MOTOR =====================
  class GameEngine~TCell, TMove, TState~ {
    <<Observer (sujeto) · sin if por variante>>
    -rules: IGameRules~TCell, TMove, TState~
    -scoring: IScoringPolicy~TState~
    -state: TState
    -score: Score
    +play(m: TMove) TurnResult~TState~
    +state: TState «get»
    +score: Score «get»
    +outcome: GameOutcome «get»
    +events: Stream~GameEvent~ «get»
    #restore(s: TState, score: Score) void  «@protected»
  }
  class UndoableGameEngine~TCell, TMove, TState~ {
    <<Command (invocador) · sólo Hexa Merge>>
    -history: MoveHistory~TMove, TState~
    +play(m: TMove) TurnResult~TState~
    +canUndo: bool
    +undo() void  (restore con before del comando)
  }
  class MoveCommand~TMove, TState~ {
    <<Command>>
    +move: TMove
    +before: TState
    +scoreBefore: Score
    +execute(applyTurn) TurnResult~TState~
  }
  class MoveHistory~TMove, TState~ {
    -capacity: int — Merge = 1
    -done: List~MoveCommand~
    +push(c: MoveCommand) void
    +popUndo() MoveCommand?
  }
  class IUndoable {
    <<interface · capacidad ISP>>
    +canUndo: bool
    +undo() void
  }

  %% ===================== PUNTUACIÓN =====================
  class Score {
    <<inmutable>>
    +value: int
    +add(points: int) Score
    +compareTo(o: Score) int
  }
  class IScoringPolicy~TState~ {
    <<interface · Strategy · punto de extensión>>
    +pointsFor(before: TState, after: TState, events: List~GameEvent~) int
  }
  class BonusMultiplierDecorator~TState~ {
    <<Decorator>>
    -inner: IScoringPolicy~TState~
    -factor: double
  }

  %% ===================== FUENTES DE PIEZAS Y AZAR =====================
  class IPieceSource~TPiece~ {
    <<interface · Strategy · punto de extensión>>
    +next(rng: IRandom) TPiece
  }
  class SeededRandomPieceSource~TPiece~ {
    -catalog: List~TPiece~
  }
  class IRandom {
    <<interface · DIP>>
    +seed: int
    +cursor: int — posición reproducible al serializar
    +nextInt(max: int) int
    +nextDouble() double
    +copy() IRandom
  }
  class SeededRandom {
    <<PRNG determinista>>
    -state: int
  }

  %% ===================== FUSIÓN (cota F) =====================
  class Mergeable~T extends Mergeable‹T›~ {
    <<interface · cota F>>
    +canMergeWith(o: T) bool
    +mergeWith(o: T) T
  }
  class SlideMergeResolver~T extends Mergeable‹T›~ {
    <<Strategy reutilizable>>
    +slide(b: HexBoard~T~, d: HexDirection) SlideResult~T~
  }

  %% ===================== PROGRESO =====================
  class IProgressModel {
    <<interface · Strategy · punto de extensión>>
    +record(r: GameResult) ProgressDelta
  }
  class HighScoreProgress {
    <<Lines · Merge>>
    -best: Score
  }
  class LevelProgress {
    <<Sort>>
    -completed: Set~String~
    +isUnlocked(levelId: String) bool
  }

  %% ===================== FÁBRICA DE VARIANTE =====================
  class GameVariantFactory~TCell, TMove, TState, TPiece~ {
    <<interface · Abstract Factory · punto de extensión>>
    +id: String — p. ej. hexa-lines; un texto, así una variante nueva no toca el núcleo
    +createBoardShape(setup: GameSetup) BoardShape
    +createPieceSource(setup: GameSetup) IPieceSource~TPiece~
    +createRules(setup: GameSetup, pieces: IPieceSource‹TPiece›) IGameRules~TCell, TMove, TState~
    +createScoring(setup: GameSetup) IScoringPolicy~TState~
    +createProgressModel() IProgressModel
    +createInitialState(setup: GameSetup) TState
  }
  class TileColor {
    <<enumeration · paleta común>>
    red · blue · green · yellow · purple
  }
  class ILevelBuilder~TSetup~ {
    <<interface · Builder>>
    +build() TSetup
  }
  class GameSetup {
    <<inmutable>>
    +seed: int
    +boardRadius: int — de configuración: Lines 4, Sort 2, Merge 2
    +levelId: String?
    +spec: Map~String, Object~
  }

  %% ===================== RELACIONES =====================
  HexDirection --> HexCoord : delta
  HexagonShape ..|> BoardShape
  HexBoard *-- "1" BoardShape : shape
  HexBoard ..> HexCoord : clave
  HexBoard ..> HexAxis : line()
  HexBoard ..> HexGeometry : delega recorridos
  HexGeometry ..> HexCoord
  GameState --> "1" HexBoard : board
  Piece ..> HexCoord : offsets

  AbstractGameRules ..|> IGameRules
  IGameRules ..> GameState : TState extends GameState‹TCell›
  IGameRules ..> TurnResult : produce
  TurnResult o-- "0..*" GameEvent
  MoveRejected --|> GameEvent
  ScoreChanged --|> GameEvent
  GameEnded --|> GameEvent
  GameState --> "1" IRandom : random
  IGameRules ..> GameOutcome

  GameEngine --> "1" IGameRules : rules
  GameEngine --> "1" IScoringPolicy : scoring
  GameEngine *-- "1" Score
  GameEngine ..> GameEvent : «publish»
  UndoableGameEngine --|> GameEngine
  UndoableGameEngine ..|> IUndoable
  UndoableGameEngine *-- "1" MoveHistory : history
  MoveHistory o-- "0..*" MoveCommand
  MoveCommand ..> TurnResult : aplica turno base una sola vez
  UndoableGameEngine ..> MoveCommand : usa before / scoreBefore

  BonusMultiplierDecorator ..|> IScoringPolicy
  BonusMultiplierDecorator o-- "1" IScoringPolicy : inner

  SeededRandomPieceSource ..|> IPieceSource
  IPieceSource ..> IRandom : recibe el del estado
  SeededRandom ..|> IRandom

  SlideMergeResolver ..> Mergeable : T extends
  HighScoreProgress ..|> IProgressModel
  LevelProgress ..|> IProgressModel

  GameVariantFactory ..> GameSetup : recibe
  GameVariantFactory ..> BoardShape : «create»
  GameVariantFactory ..> IPieceSource : «create»
  GameVariantFactory ..> IGameRules : «create»
  GameVariantFactory ..> IScoringPolicy : «create»
  GameVariantFactory ..> IProgressModel : «create»
  ILevelBuilder ..> GameSetup : TSetup = GameSetup

  note for UndoableGameEngine "Subclase (LSP): sustituye a GameEngine donde se<br>espere. Guarda un turno válido; al restaurar recupera<br>tablero, marcador y cursor aleatorio. Sólo Merge la usa: Lines y Sort no<br>implementan IUndoable (ISP, ejemplo del enunciado)."
  note for GameEngine "Ciclo del turno (playTurn): validar → aplicar →<br>resolver → reponer → evaluar → notificar.<br>Movimiento inválido: estado igual + MoveRejected.<br>Nunca pregunta qué variante es (LSP/OCP).<br>En Dart: @nonVirtual y @protected de package:meta."
  note for GameEvent "Abierto (no sealed): el núcleo sólo define los eventos<br>comunes. LinesCleared, StackTransferred, TilesMerged…<br>viven en su variante: una 5.ª variante agrega sus<br>eventos sin tocar el núcleo (OCP)."
  note for IRandom "Regla de inmutabilidad: apply() trabaja con<br>s.random.copy() y guarda la copia en el estado<br>nuevo; nunca avanza el generador de un estado<br>anterior. Así deshacer repite la misma ficha.<br>createInitialState crea SeededRandom(setup.seed)."
  note for GameVariantFactory "TCell extends Object; TState extends GameState‹TCell›.<br>La fuente produce TPiece. Sólo el resolver de fusión<br>exige T extends Mergeable‹T›."
  note for Mergeable "Cota F: sólo se fusionan objetos del mismo tipo.<br>El enunciado sugiere TCell = int para Merge, pero<br>int no puede implementar interfaces en Dart:<br>MergeTile envuelve el int (vista 2c)."

  %% ===================== LEYENDA =====================
  class LEG1["Capa 1 · Entidades — núcleo genérico (hexa_engine/core)"]
  class LEG1b["Capa 1 · Entidades — variantes (hexa_engine/variants)"]
  class LEG2["Capa 2 · Casos de uso (hexa_application)"]
  class LEG3["Capa 3 · Adaptadores (hexa_infrastructure · app)"]
  class LEG5["Borde naranja = punto de extensión del motor"]
