  %% ===================== CONTRATOS DEL NÚCLEO (detalle en la vista 1) =====================
  class AbstractGameRules~TCell, TMove, TState~ {
    <<abstract · Template Method>>
  }
  class GameState~TCell extends Object~ {
    <<interface>>
  }
  class IScoringPolicy~TState~ {
    <<interface · Strategy>>
  }
  class IPieceSource~TPiece~ {
    <<interface · Strategy>>
  }
  class SeededRandomPieceSource~TPiece~
  class GameVariantFactory~TCell, TMove, TState, TPiece~ {
    <<interface · Abstract Factory>>
  }
  class LevelProgress
  class HexDirection {
    <<enumeration>>
  }
  class TileColor {
    <<enumeration · paleta común del núcleo>>
    red · blue · green · yellow · purple
  }
  class ILevelBuilder~TSetup~ {
    <<interface · Builder>>
    +build() TSetup
  }
  class HexagonShape {
    <<forma del tablero>>
  }
  class GameEvent {
    <<abstract · Observer>>
  }

  %% ===================== B · HEXA SORT (radio 2, pilas en cascada) =====================
  class ColorStack {
    <<TCell · inmutable>>
    -chips: List~TileColor~ — abajo → arriba
    +topColor: TileColor
    +topRun: int
    +takeTopRun() (ColorStack, List~TileColor~)
    +push(chips: List~TileColor~) ColorStack
  }
  class PlaceStack {
    <<TMove · inmutable>>
    +trayIndex: int
    +coord: HexCoord
    +at: Duration — tiempo de partida; lo pone la app con un reloj inyectado
  }
  class SortState {
    <<TState · inmutable>>
    +board: HexBoard~ColorStack~
    +tray: List~ColorStack?~ — 3 pilas; se repone al usarlas todas
    +goal: ILevelGoal
    +cleared: Map‹TileColor, int› — fichas eliminadas por color
    +points: int — 10 por ficha eliminada + racha
    +elapsed: Duration
    +lastClearAt: Duration?
  }
  class ILevelGoal {
    <<interface · Strategy · punto de extensión>>
    +isMet(s: SortState) bool
    +progress(s: SortState) double
  }
  class ScoreGoal {
    <<meta de niveles iniciales>>
    +target: int
  }
  class ColorsClearedGoal {
    <<meta de niveles avanzados>>
    +required: Map‹TileColor, int›
  }
  class TimeTiers {
    <<inmutable · bonificación por tiempo>>
    +bonus(elapsed: Duration) int — ≤1 min 100 · ≤2,5 min 50 · ≤5 min 10 · si no 0
  }
  class HexaSortRules {
    -cascade: CascadeTransferResolver
    -stacks: IPieceSource~ColorStack~
    #apply(...) SortState  (coloca la pila)
    #resolve(...) SortState  (cascada)
    +evaluate(s) GameOutcome  (goal.isMet / sin celdas libres)
  }
  class CascadeTransferResolver {
    <<Strategy>>
    -direction: ITransferDirectionPolicy
    -clearAt: int = 10
    -order: List~HexDirection~ — sentido horario, empieza en northEast
    +resolve(b, placedAt) CascadeResult
    -amount(from, to) int — min(racha, 10 − racha destino)
    -clearIfComplete(s: ColorStack) ColorStack? — elimina la pila completa
  }
  class ITransferDirectionPolicy {
    <<interface · Strategy · punto de extensión>>
    +onTie(a: HexCoord, b: HexCoord, placedAt: HexCoord) Transfer
  }
  class ExistingToPlacedPolicy {
    <<regla del equipo>>
    +onTie(...) Transfer — existente → nueva
  }
  class Transfer {
    <<inmutable>>
    +from: HexCoord
    +to: HexCoord
  }
  class StackTransferred {
    <<evento de la variante>>
    +from: HexCoord
    +to: HexCoord
    +color: TileColor
  }
  class StackCompleted {
    <<evento de la variante>>
    +color: TileColor
  }
  class SortGoalScoring {
    -tiers: TimeTiers
    +pointsFor(before, after, events) int — Δpoints + bonus por tiempo al ganar
  }
  class SortLevelBuilder {
    <<Builder (concreto)>>
    +withGoal(g: ILevelGoal) SortLevelBuilder
    +withColors(c: List~TileColor~) SortLevelBuilder
    +withSeed(seed: int) SortLevelBuilder
    +build() GameSetup
  }
  class HexaSortFactory {
    <<Abstract Factory (concreta)>>
    +id = hexa-sort
  }
  ColorStack --> TileColor
  SortState ..|> GameState : «bind» TCell→ColorStack
  HexaSortRules --|> AbstractGameRules : «bind» ‹ColorStack, PlaceStack, SortState›
  HexaSortRules *-- "1" CascadeTransferResolver
  HexaSortRules --> "1" IPieceSource : stacks
  CascadeTransferResolver --> "1" ITransferDirectionPolicy : direction
  ExistingToPlacedPolicy ..|> ITransferDirectionPolicy
  ITransferDirectionPolicy ..> Transfer : devuelve
  SortState --> "1" ILevelGoal : goal
  ScoreGoal ..|> ILevelGoal
  ColorsClearedGoal ..|> ILevelGoal
  SortGoalScoring --> "1" TimeTiers
  SortLevelBuilder ..> ILevelGoal : withGoal
  StackTransferred --|> GameEvent
  StackCompleted --|> GameEvent
  CascadeTransferResolver ..> StackTransferred : emite
  CascadeTransferResolver ..> StackCompleted : emite
  SeededRandomPieceSource ..|> IPieceSource : «bind» TPiece→ColorStack
  SortGoalScoring ..|> IScoringPolicy : «bind» TState→SortState
  SortLevelBuilder ..|> ILevelBuilder : «bind» TSetup→GameSetup
  HexaSortFactory ..|> GameVariantFactory : «bind» ‹ColorStack, PlaceStack, SortState, ColorStack›
  HexaSortFactory ..> HexagonShape : «create» radio = setup.boardRadius
  HexaSortFactory ..> SeededRandomPieceSource : «create»
  HexaSortFactory ..> HexaSortRules : «create»
  HexaSortFactory ..> SortGoalScoring : «create»
  HexaSortFactory ..> LevelProgress : «create»
  HexaSortFactory ..> ExistingToPlacedPolicy : «create» regla vigente
  note for ITransferDirectionPolicy "Regla general: pasa de la pila con menos fichas de ese<br>color a la que tiene más. Empate: la existente pasa a la<br>recién colocada (regla del equipo). Si ninguna es nueva,<br>decide el orden horario de CascadeTransferResolver."
  note for CascadeTransferResolver "Solo pasan las fichas que faltan para llegar a 10; el<br>sobrante se queda en la pila de origen. Con 10 se elimina<br>la PILA COMPLETA (acordado con el profesor), sus fichas<br>cuentan en cleared por color, se emite StackCompleted<br>y se revisan otra vez los vecinos en orden horario."
  note for PlaceStack "El tiempo entra como dato del movimiento:<br>el motor no lee el reloj y las pruebas<br>siguen siendo deterministas."
  note for ILevelGoal "Cada nivel trae UNA meta en su JSON:<br>puntos (niveles iniciales) o fichas por<br>color (niveles avanzados)."

  %% ===================== LEYENDA =====================
