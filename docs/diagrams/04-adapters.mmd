  %% ===================== hexa_infrastructure · ADAPTADORES =====================
  class DriftProgressRepository {
    <<Adapter · drift/SQLite>>
    -db: AppDatabase
  }
  class DriftScoreQueue {
    <<Adapter · drift/SQLite>>
    -db: AppDatabase
  }
  class AppDatabase {
    <<drift>>
    game_progress · level_progress · pending_scores
    columna data en json, la guarda cada IProgressModel
  }
  class AssetLevelSource {
    <<Adapter · assets JSON>>
    -catalog: GameCatalog — pide el levelParser del gameId
  }
  class RemoteLevelSource {
    <<Adapter · GET /games/:gameId/levels>>
    -catalog: GameCatalog — pide el levelParser del gameId
    +levels(game: String) Future~List‹GameSetup›~
  }
  class FallbackLevelSource {
    <<Adapter · catálogo de niveles>>
    +levels(game: String) Future~List‹GameSetup›~
  }
  class SortLevelParser {
    <<Adapter · Builder (director) de Sort>>
    +parse(json: Map) GameSetup — withSeed · withColors · withGoal · build
  }
  class DioApiGateway {
    <<Adapter · dio + JWT>>
    -dio: Dio
    -session: ISessionStore
    +sync(p) Future~Progress~
    +submit(s) Future~void~
    +top(q) Future~Leaderboard~
    +login(...) Future~Session~
  }
  class ProblemJsonMapper {
    +toFailure(DioException) ApiFailure
  }
  class LocalSessionStore {
    <<Adapter · Singleton (alcance único DI)>>
  }
  class SecureSeedProvider
  class StopwatchClock {
    <<Adapter · Stopwatch de Dart>>
    +elapsed() Duration
  }
  class DebugLogger

  %% ===================== app · UN MÓDULO POR VARIANTE =====================
  class HexaLinesModule {
    -factory: HexaLinesFactory
  }
  class HexaSortModule {
    -factory: HexaSortFactory
  }
  class HexaMergeModule {
    -factory: HexaMergeFactory
  }
  class IGameUiModule {
    <<interface · borde de presentación · ISP>>
    +id: String — el mismo que en GameModule
    +buildBoard(vm: GameViewModel) Widget — HexBoardView‹TCell› con su CellRenderer‹TCell›
    +createMoveInput() IMoveInput‹…›
    +buildControls(vm: GameViewModel) Widget? — bandeja, paleta o metas; null si no hay
    +sounds: Map‹Type, String› — sonido por evento de la variante
  }

  %% ===================== app · TABLERO VISUAL COMPARTIDO =====================
  class HexBoardView~TCell~ {
    <<BoardRenderer · widget compartido>>
    -renderer: CellRenderer~TCell~
    +cells: List~CellVM‹TCell›~ — recorre BoardShape.cells: cualquier forma
    +hitTest(p: Offset) HexCoord? — toque o arrastre → coordenada axial
  }
  class GameScreen {
    <<pantalla genérica · la misma para todos los juegos>>
    -board: Widget — lo crea IGameUiModule.buildBoard
    -vm: GameViewModel
  }
  class BoardGesture {
    <<inmutable · tap · arrastre · deslizamiento>>
    +kind: GestureKind
    +from: HexCoord?
    +to: HexCoord?
    +trayIndex: int?
    +direction: HexDirection?
  }
  class GestureKind {
    <<enumeration>>
    tap
    drag
    swipe
  }
  class IMoveInput~TMove~ {
    <<interface · Strategy · punto de extensión>>
    +toMove(g: BoardGesture, ui: UiState) TMove? — null si el gesto no aplica
  }
  class LinesMoveInput
  class SortMoveInput
  class MergeMoveInput
  class CellRenderer~TCell~ {
    <<interface · Strategy · punto de extensión>>
    +paint(canvas: Canvas, c: HexCoord, cell: TCell) void
  }
  class LinesCellRenderer
  class SortCellRenderer
  class MergeCellRenderer

  %% ===================== app · PRESENTACIÓN =====================
  class GameViewModel {
    <<Presenter · observa GameEvent>>
    -facade: GameServiceFacade
    +state: UiState
    +board: List~CellVM~ — lo que dibuja la vista
    -input: IMoveInput‹TMove› — lo aporta el módulo del juego
    +onGesture(g: BoardGesture) void — input.toMove(g) → session.move
    +onUndo() void  (solo si el motor es IUndoable)
    +onRedo() void  (solo si el motor es IRedoable → facade.redo)
    +onAnimationsDone() void  (→ session.finishResolving)
  }
  class GameServiceFacade {
    <<Facade>>
    -start: UseCase
    -move: UseCase
    -undo: UseCase
    -redo: UseCase
    -save: UseCase
    +start(game, setup) Future
    +move(m) Future
    +undo() Future
    +redo() Future
    +finish(result) Future
  }
  class AudioManager {
    <<Singleton (alcance único DI) · Observer · Adapter>>
    -sounds: Map‹Type, String› — los aporta cada IGameUiModule
    +onEvent(e: GameEvent) void  (sonido por defecto si no lo conoce)
    +setMuted(m: bool) void
  }
  class AppProviders {
    <<Composition Root · Riverpod>>
    +catalog: Provider~GameCatalog~
    +uiModules: Provider~Map‹String, IGameUiModule›~ — por gameId
    +useCases: Provider~...~ — envueltos con aspectos
  }

  %% ===================== RELACIONES =====================
  DriftProgressRepository ..|> IProgressRepository
  DriftProgressRepository --> AppDatabase
  DriftScoreQueue ..|> IScoreQueue
  DriftScoreQueue --> AppDatabase
  RemoteLevelSource ..|> ILevelSource
  RemoteLevelSource ..> ILevelParser : por gameId
  RemoteLevelSource --> GameCatalog
  FallbackLevelSource ..|> ILevelSource
  FallbackLevelSource --> RemoteLevelSource : fuente preferida
  FallbackLevelSource --> AssetLevelSource : catálogo incluido sin red
  AppProviders ..> FallbackLevelSource : inyecta en LoadLevelsUseCase
  AssetLevelSource ..|> ILevelSource
  AssetLevelSource ..> ILevelParser : por gameId
  AssetLevelSource --> GameCatalog
  SortLevelParser ..|> ILevelParser
  SortLevelParser ..> SortLevelBuilder : «create» y dirige
  SortLevelBuilder ..|> ILevelBuilder
  HexaSortModule ..> SortLevelParser : «create»
  DioApiGateway ..|> IProgressGateway
  DioApiGateway ..|> ILeaderboardGateway
  DioApiGateway ..|> IAuthGateway
  DioApiGateway --> ISessionStore : token JWT
  DioApiGateway --> ProblemJsonMapper
  LocalSessionStore ..|> ISessionStore
  SecureSeedProvider ..|> ISeedProvider
  StopwatchClock ..|> IClock
  HexaSortModule --> IClock : sella PlaceStack.at
  DebugLogger ..|> ILogger

  HexaLinesModule ..|> GameModule
  HexaSortModule ..|> GameModule
  HexaMergeModule ..|> GameModule
  HexaLinesModule ..|> IGameUiModule
  HexaSortModule ..|> IGameUiModule
  HexaMergeModule ..|> IGameUiModule
  GameScreen ..> IGameUiModule : tablero, input y controles
  IGameUiModule ..> HexBoardView : «create» ya tipado
  IGameUiModule ..> CellRenderer : «create»
  IGameUiModule ..> IMoveInput : «create»
  AppProviders ..> IGameUiModule : registra por gameId
  AudioManager ..> IGameUiModule : sounds
  GameViewModel --> "1" GameServiceFacade : facade
  GameViewModel ..> GameEvent : escucha
  HexBoardView --> "1" CellRenderer : renderer
  GameScreen o-- "1" HexBoardView : vía buildBoard
  GameScreen --> "1" GameViewModel
  GameViewModel --> "1" IMoveInput : input
  IMoveInput ..> BoardGesture : traduce
  BoardGesture --> GestureKind
  LinesMoveInput ..|> IMoveInput : «bind» TMove→PlacePiece
  SortMoveInput ..|> IMoveInput : «bind» TMove→PlaceStack
  MergeMoveInput ..|> IMoveInput : «bind» TMove→Slide
  HexaLinesModule ..> LinesMoveInput : «create»
  HexaSortModule ..> SortMoveInput : «create»
  HexaMergeModule ..> MergeMoveInput : «create»
  HexBoardView ..> GameViewModel : cells · gestos → onGesture
  LinesCellRenderer ..|> CellRenderer : «bind» TCell→TileColor
  SortCellRenderer ..|> CellRenderer : «bind» TCell→ColorStack
  MergeCellRenderer ..|> CellRenderer : «bind» TCell→MergeTile
  HexaLinesModule ..> LinesCellRenderer : «create»
  HexaSortModule ..> SortCellRenderer : «create»
  HexaMergeModule ..> MergeCellRenderer : «create»
  GameServiceFacade --> UseCase : usa (decorados)
  AudioManager ..> GameEvent : escucha
  GameServiceFacade --> AudioManager : silenciar / volumen

  AppProviders ..> GameCatalog : registra 3 módulos
  AppProviders ..> UseCase : envuelve con aspectos
  AppProviders ..> DioApiGateway : «create»
  AppProviders ..> DriftProgressRepository : «create»
  AppProviders ..> DriftScoreQueue : «create»

  note for DioApiGateway "Un adaptador, tres puertos (ISP del lado<br>del puerto). Los errores RFC 9457 de la API<br>se traducen a ApiFailure en un solo lugar."
  note for AppProviders "Único lugar que conoce las clases concretas.<br>Agregar Hexa Fill = 1 módulo nuevo +<br>1 línea aquí."
  note for HexaMergeModule "El de Merge crea su partida con UndoableGameEngine."
  note for IGameUiModule "GameModule (capa 2) es Dart puro y no conoce<br>Flutter. Lo visual de cada juego va aquí (capa 3):<br>cada módulo implementa las dos interfaces y<br>GameScreen pide la suya a AppProviders por id.<br>buildBoard crea HexBoardView‹TCell› con su<br>CellRenderer‹TCell›: los genéricos se cierran en el<br>módulo y Dart revisa los tipos al compilar.<br>Una variante nueva no modifica GameScreen."
  note for IMoveInput "Una variante que se juega distinto (por ejemplo,<br>pintar celdas en Hexa Fill) trae su IMoveInput,<br>su CellRenderer y su módulo. GameScreen,<br>GameViewModel y HexBoardView no se modifican."
  note for HexBoardView "Un solo tablero para los 3 juegos (SRP: el renderizado<br>separado de las reglas). Cada variante solo aporta<br>cómo se pinta su celda. El enunciado califica como<br>insuficiente repetir tablero o renderizado."

  %% ===================== LEYENDA =====================
  class LEG1["Capa 1 · Entidades — núcleo genérico (hexa_engine/core)"]
  class LEG1b["Capa 1 · Entidades — variantes (hexa_engine/variants)"]
