---
title: "HexaBlock Suite · Modelo de clases v5 (3/5) — Casos de uso, puertos, AOP y estado de sesión · packages/hexa_application"
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: "Inter"
    fontSize: "15px"
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction LR

  %% ===================== ENTIDADES (referencias, ver vistas 1 y 2) =====================
  class GameEngine~TCell, TMove, TState~ {
    <<Capa 1>>
  }
  class IUndoable {
    <<interface · capacidad ISP>>
  }
  class GameVariantFactory~TCell, TMove, TState, TPiece~ {
    <<interface · Abstract Factory>>
  }
  class GameEvent {
    <<abstract · Observer>>
  }
  class IProgressModel {
    <<interface · Strategy>>
  }

  %% ===================== CONTRATO DE CASO DE USO + AOP =====================
  class UseCase~I, O~ {
    <<interface>>
    +execute(input: I) Future~O~
  }
  class LoggingUseCase~I, O~ {
    <<AOP · Decorator>>
    -inner: UseCase~I, O~
    -log: ILogger
  }

  %% ===================== CASOS DE USO (genéricos, nunca uno por juego) =====================
  class StartGameUseCase {
    -catalog: GameCatalog
    -seeds: ISeedProvider
    -saved: ISavedGameStore
    +execute(r: StartGameRequest) Future~GameSession~
  }
  class ApplyMoveUseCase {
    +execute(r: MoveRequest) Future~MoveResult~  (MoveRequest = sesión + movimiento)
  }
  class UndoMoveUseCase {
    +execute(s: GameSession) Future~MoveResult~
  }
  class LoadLevelsUseCase {
    -levels: ILevelSource
    +execute(game: String) Future~List‹LevelSummary›~
  }
  class SaveProgressUseCase {
    -repo: IProgressRepository
    -catalog: GameCatalog — pide el IProgressModel del juego
    +execute(r: GameResult) Future~void~
  }
  class SyncProgressUseCase {
    -repo: IProgressRepository
    -gateway: IProgressGateway
    +execute(game: String) Future~Progress~
  }
  class SyncLeaderboardUseCase {
    -repo: IProgressRepository
    -gateway: ILeaderboardGateway
    +execute(game: String) Future~void~  (envía puntajes pendientes)
  }
  class GetLeaderboardUseCase {
    -gateway: ILeaderboardGateway
    +execute(q: LeaderboardQuery) Future~Leaderboard~
  }
  class LoginUseCase {
    -auth: IAuthGateway
    -session: ISessionStore
  }
  class RegisterUseCase {
    -auth: IAuthGateway
  }

  %% ===================== REGISTRO DE VARIANTES Y SESIÓN (State) =====================
  class GameModule {
    <<interface · borde no genérico>>
    +id: String
    +name: String
    +progressKind: ProgressKind
    +createSession(setup: GameSetup) GameSession‹…›  (genéricos cerrados aquí)
    +createProgressModel() IProgressModel
  }
  class GameCatalog {
    <<registro · OCP>>
    -modules: Map~String, GameModule~
    +register(m: GameModule) void
    +byId(id: String) GameModule
    +all() List~GameModule~
  }
  class GameSession~TCell, TMove, TState~ {
    <<State (contexto)>>
    -state: SessionState
    +engine: GameEngine~TCell, TMove, TState~
    +start() void  (MenuState → PlayingState)
    +move(m: TMove) TurnResult~TState~  (PlayingState → ResolvingState)
    +finishResolving() void  (→ PlayingState, GameOverState o VictoryState)
    +pause() void
    +resume() void
    +reconcileAfterUndo() void
    +events: Stream~GameEvent~
  }
  class SessionState {
    <<interface · State>>
    +onMove(ctx, m) void
    +onPause(ctx) void
    +onResume(ctx) void
  }
  class MenuState
  class PlayingState
  class ResolvingState
  class PausedState
  class GameOverState
  class VictoryState

  %% ===================== PUERTOS DE SALIDA =====================
  class IProgressRepository {
    <<interface · puerto>>
    +load(game: String) Future~Progress~
    +save(p: Progress) Future~void~
  }
  class ISavedGameStore {
    <<interface · puerto>>
    +load(game: String) Future~String?~
    +save(game: String, json: String) Future~void~
  }
  class ILevelSource {
    <<interface · puerto>>
    +levels(game: String) Future~List‹GameSetup›~
  }
  class IProgressGateway {
    <<interface · puerto>>
    +sync(p: Progress) Future~Progress~
  }
  class ILeaderboardGateway {
    <<interface · puerto>>
    +submit(s: ScoreEntry) Future~void~
    +top(q: LeaderboardQuery) Future~Leaderboard~
  }
  class IAuthGateway {
    <<interface · puerto>>
    +login(email, password) Future~Session~
    +register(email, password, name) Future~void~
  }
  class ISessionStore {
    <<interface · puerto>>
    +current: Session?
    +save(s: Session) Future~void~
    +clear() Future~void~
  }
  class IStateSerializer~TState~ {
    <<interface · puerto · Mapper>>
    +toJson(s: TState) String
    +fromJson(json: String) TState
  }
  class ISeedProvider {
    <<interface · puerto>>
    +newSeed() int
  }
  class ILogger {
    <<interface · puerto>>
    +info(msg: String) void
    +error(msg, e, st) void
  }


  %% ===================== RELACIONES =====================
  LoggingUseCase ..|> UseCase
  LoggingUseCase o-- "1" UseCase : inner
  LoggingUseCase --> ILogger

  StartGameUseCase ..|> UseCase
  ApplyMoveUseCase ..|> UseCase
  UndoMoveUseCase ..|> UseCase
  LoadLevelsUseCase ..|> UseCase
  SaveProgressUseCase ..|> UseCase
  SyncProgressUseCase ..|> UseCase
  SyncLeaderboardUseCase ..|> UseCase
  GetLeaderboardUseCase ..|> UseCase
  LoginUseCase ..|> UseCase
  RegisterUseCase ..|> UseCase

  StartGameUseCase --> GameCatalog
  StartGameUseCase --> ISeedProvider
  StartGameUseCase --> ISavedGameStore
  ApplyMoveUseCase ..> GameSession : move()
  UndoMoveUseCase ..> GameSession : recupera engine y actualiza fase
  UndoMoveUseCase ..> IUndoable : capacidad del motor de la sesión
  LoadLevelsUseCase --> ILevelSource
  SaveProgressUseCase --> IProgressRepository
  SaveProgressUseCase --> GameCatalog
  SyncProgressUseCase --> IProgressRepository
  SyncProgressUseCase --> IProgressGateway
  SyncLeaderboardUseCase --> IProgressRepository
  SyncLeaderboardUseCase --> ILeaderboardGateway
  GetLeaderboardUseCase --> ILeaderboardGateway
  LoginUseCase --> IAuthGateway
  LoginUseCase --> ISessionStore
  RegisterUseCase --> IAuthGateway

  GameCatalog o-- "3..*" GameModule
  GameModule ..> GameVariantFactory : usa
  GameModule ..> IStateSerializer : usa
  GameModule ..> GameSession : «create»
  GameSession --> "1" SessionState : state
  GameSession --> "1" GameEngine : engine
  GameModule ..> IProgressModel : «create» vía su factory
  GameSession ..> GameEvent : reenvía
  MenuState ..|> SessionState
  PlayingState ..|> SessionState
  ResolvingState ..|> SessionState
  PausedState ..|> SessionState
  GameOverState ..|> SessionState
  VictoryState ..|> SessionState

  note for GameModule "Borde no genérico: el selector y las rutas sólo ven<br>GameModule; los genéricos quedan cerrados dentro de<br>cada módulo. Una 5.ª variante = 1 módulo + 1 línea<br>en el catálogo."
  note for LoggingUseCase "AOP sin librerías: el composition root envuelve<br>ApplyMoveUseCase (genérico) una sola vez y el<br>aspecto cubre las 3 variantes: registra nombre, resultado y duración<br>sin registrar credenciales ni datos personales."

  %% ===================== LEYENDA =====================
  class LEG1["Capa 1 · Entidades — núcleo genérico (hexa_engine/core)"]
  class LEG1b["Capa 1 · Entidades — variantes (hexa_engine/variants)"]
  class LEG2["Capa 2 · Casos de uso (hexa_application)"]
  class LEG3["Capa 3 · Adaptadores (hexa_infrastructure · app)"]
  class LEG5["Borde naranja = punto de extensión del motor"]
