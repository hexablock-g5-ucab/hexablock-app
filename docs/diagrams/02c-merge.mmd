  %% ===================== C · HEXA MERGE (radio 2, 2048 en 6 direcciones) =====================
  class MergeTile {
    <<TCell · inmutable>>
    +value: int — potencia de 2
    +canMergeWith(o: MergeTile) bool
    +mergeWith(o: MergeTile) MergeTile
  }
  class Slide {
    <<TMove · inmutable>>
    +direction: HexDirection
  }
  class MergeState {
    <<TState · inmutable>>
    +board: HexBoard~MergeTile~
    +random: IRandom — heredado de GameState
    +target: int — p. ej. 2048
  }
  class HexaMergeRules {
    -slider: SlideMergeResolver~MergeTile~
    -spawner: IPieceSource~MergeTile~
    #apply(...) MergeState  (deslizar + fusionar)
    #resolve(...) MergeState  (no-op: la fusión ocurre al deslizar)
    #afterResolve(...) MergeState  (genera 2 o 4)
    +evaluate(s) GameOutcome  (objetivo / sin movimientos)
  }
  class TileSpawner {
    -pFour: double = 0.1
    +next(rng: IRandom) MergeTile
  }
  class TilesMerged {
    <<evento de la variante>>
    +value: int
  }
  class MergeSumScoring {
    +pointsFor(before, after, events) int  (suma de fusiones)
  }
  class HexaMergeFactory {
    <<Abstract Factory (concreta)>>
    +id = hexa-merge
  }
  MergeTile ..|> Mergeable : «bind» T→MergeTile
  MergeState ..|> GameState : «bind» TCell→MergeTile
  HexaMergeRules --|> AbstractGameRules : «bind» ‹MergeTile, Slide, MergeState›
  HexaMergeRules *-- "1" SlideMergeResolver : «bind» T→MergeTile
  HexaMergeRules --> "1" IPieceSource : spawner
  TileSpawner ..|> IPieceSource : «bind» TPiece→MergeTile
  TileSpawner ..> IRandom : usa el del estado
  TilesMerged --|> GameEvent
  HexaMergeRules ..> TilesMerged : emite (con el SlideResult)
  MergeSumScoring ..|> IScoringPolicy : «bind» TState→MergeState
  HexaMergeFactory ..|> GameVariantFactory : «bind» ‹MergeTile, Slide, MergeState, MergeTile›
  HexaMergeFactory ..> HexagonShape : «create» radio = setup.boardRadius
  HexaMergeFactory ..> TileSpawner : «create»
  HexaMergeFactory ..> HexaMergeRules : «create»
  HexaMergeFactory ..> MergeSumScoring : «create»
  HexaMergeFactory ..> HighScoreProgress : «create»
  note for UndoableGameEngine "HexaMergeModule compone el motor con las reglas<br>y la puntuación que produce HexaMergeFactory."
  note for MergeState "El estado del IRandom viaja en la instantánea:<br>deshacer y repetir el deslizamiento genera<br>la misma ficha (no se puede «pescar» un 4)."

